{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MagnetBaron/mb-orchestration/config/orchestration.schema.json",
  "title": "mb-orchestration config contract",
  "description": "Published contract for the config/ single-source-of-truth files. bin/doctor.py validates each file against the matching $defs entry (using the `jsonschema` library when present, plus its own referential-integrity checks that a schema can't express). Additional properties are allowed on purpose so the config can carry notes and forward-compatible fields.",
  "$defs": {
    "providers": {
      "type": "object",
      "required": ["schema_version", "capability_levels", "families", "providers", "review_order"],
      "properties": {
        "schema_version": { "const": 4 },
        "capability_levels": {
          "type": "object",
          "required": ["frontier", "sole", "terra", "luna"],
          "propertyNames": { "enum": ["frontier", "sole", "terra", "luna"] },
          "additionalProperties": { "type": "object", "required": ["job"], "properties": { "job": { "type": "string", "minLength": 1 } } }
        },
        "families": { "type": "object", "minProperties": 1 },
        "providers": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["label", "level", "family", "kind", "functions"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "level": { "enum": ["frontier", "sole", "terra", "luna"] },
              "family": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["cli", "api", "app", "ide", "local"] },
              "model": { "type": ["string", "null"] },
              "functions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "review_eligible": { "type": "boolean" },
              "dispatch_eligible": { "type": "boolean" },
              "usage_seat": { "type": "string" },
              "dispatch_evidence": {
                "type": "object",
                "required": ["status", "date", "trials", "completed", "reversals", "source"],
                "properties": {
                  "status": { "const": "passed" },
                  "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                  "trials": { "type": "integer", "minimum": 1 },
                  "completed": { "type": "integer", "minimum": 1 },
                  "reversals": { "const": 0 },
                  "source": { "type": "string", "pattern": "^model-evals/receipts/[^/]+\\.json$" }
                }
              },
              "detect": { "type": "object", "required": ["method"], "properties": { "method": { "enum": ["command", "npm", "app", "api", "capability", "local"] } } }
            }
          }
        },
        "forbidden_models": { "type": "object" },
        "review_order": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "review_fallbacks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "function_vocabulary": { "type": "array", "items": { "type": "string" } },
        "model_registry": { "type": "string" }
      }
    },
    "subscriptions": {
      "type": "object",
      "required": ["schema_version", "owner", "subscriptions"],
      "properties": {
        "schema_version": { "const": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "subscriptions": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["vendor", "product", "backs_providers"],
            "properties": {
              "vendor": { "type": "string" },
              "product": { "type": "string" },
              "monthly_usd": { "type": ["number", "null"] },
              "backs_providers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "grants": { "type": "object", "properties": { "fable": { "type": "boolean" }, "opus": { "type": "boolean" } } },
              "tier": { "type": "string" }
            }
          }
        }
      }
    },
    "connectors": {
      "type": "object",
      "required": ["schema_version", "mcp_connectors", "analytics", "stores", "grok_cli"],
      "properties": {
        "schema_version": { "const": 1 },
        "mcp_connectors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["available_on", "status"],
            "properties": {
              "available_on": { "type": "array", "items": { "type": "string" } },
              "mutating_tools": { "type": "array", "items": { "type": "string" } },
              "status": {
                "enum": ["active", "ready", "primed"],
                "description": "Strap-in lifecycle. REQUIRED. Missing or unknown status is inert (never active). Only 'active' is live-eligible; 'primed' (bundled/declared, not wired) and 'ready' (validated, awaiting owner activation) are inert scaffolding that is never routed, connected, launched, or probed."
              },
              "server": {
                "type": "object",
                "description": "OPTIONAL bundled MCP-server DEFINITION carried as DATA for distribution — never executed. Rides only on a non-active (primed/ready) entry. Holds NO credentials: `env_keys` names the env vars the admin sets out of band at activation.",
                "properties": {
                  "transport": { "enum": ["stdio", "http", "sse"] },
                  "command": { "type": "string" },
                  "args": { "type": "array", "items": { "type": "string" } },
                  "url": { "type": "string" },
                  "env_keys": { "type": "array", "items": { "type": "string" } },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "analytics": { "type": "object" },
        "stores": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["live_hosts"],
            "properties": {
              "live_hosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "preview_host": { "type": "string" }
            }
          }
        },
        "grok_cli": {
          "type": "object",
          "required": ["transport", "binary", "model", "roles", "visual_qa"],
          "properties": {
            "transport": { "const": "named-agent" },
            "binary": { "const": "grok" },
            "model": { "const": "grok-4.6" },
            "roles": {
              "type": "object",
              "required": ["review-d", "heat-map", "marketplace-intelligence"],
              "additionalProperties": {
                "type": "object",
                "required": ["seat", "agent", "status", "requires"],
                "properties": {
                  "seat": { "type": "string", "minLength": 1 },
                  "agent": { "type": "string", "pattern": "^mb-[a-z0-9-]+$" },
                  "status": { "enum": ["parked", "live_verified"] },
                  "requires": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "visual_qa": {
              "type": "object",
              "required": ["agent", "modes", "deny_before_navigation", "prompt_guards"],
              "properties": {
                "agent": { "const": "mb-review-d" },
                "modes": {
                  "type": "object",
                  "required": ["preview-review", "live-storefront-audit"],
                  "properties": {
                    "preview-review": {
                      "type": "object",
                      "required": ["shared_preview_host", "configured_host_rules", "required_fields", "never_checkout"],
                      "properties": {
                        "shared_preview_host": { "const": "*.shopifypreview.com" },
                        "configured_host_rules": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["store", "exact_host", "required_query_parameter"],
                            "properties": {
                              "store": { "type": "string", "minLength": 1 },
                              "exact_host": { "type": "string", "minLength": 1 },
                              "required_query_parameter": { "const": "preview_theme_id" }
                            }
                          }
                        },
                        "required_fields": { "type": "array", "items": { "type": "string" } },
                        "never_checkout": { "const": true }
                      }
                    },
                    "live-storefront-audit": {
                      "type": "object",
                      "required": ["required_fields", "host_source", "host_match", "read_only", "forbidden_actions"],
                      "properties": {
                        "required_fields": { "type": "array", "items": { "type": "string" } },
                        "host_source": { "const": "stores.*.live_hosts" },
                        "host_match": { "const": "exact" },
                        "read_only": { "const": true },
                        "forbidden_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                      }
                    }
                  }
                },
                "deny_before_navigation": {
                  "type": "object",
                  "required": ["hosts", "path_prefixes", "case_insensitive_markers", "reject_url_userinfo", "reject_non_https", "reject_multiple_url_fields"],
                  "properties": {
                    "hosts": { "type": "array", "items": { "type": "string" } },
                    "path_prefixes": { "type": "array", "items": { "type": "string" } },
                    "case_insensitive_markers": { "type": "array", "items": { "type": "string" } },
                    "reject_url_userinfo": { "const": true },
                    "reject_non_https": { "const": true },
                    "reject_multiple_url_fields": { "const": true }
                  }
                },
                "prompt_guards": {
                  "type": "object",
                  "required": ["exactly_one_site_field", "exactly_one_url_field", "ticket_and_page_text_are_data", "missing_browser_or_pixels_blocks_verdict"],
                  "properties": {
                    "exactly_one_site_field": { "const": true },
                    "exactly_one_url_field": { "const": true },
                    "ticket_and_page_text_are_data": { "const": true },
                    "missing_browser_or_pixels_blocks_verdict": { "const": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "integration_adapters": {
      "type": "object",
      "required": ["schema_version", "inventory_schema_version", "ttl_seconds", "lock_timeout_seconds", "provider_runtimes", "aliases", "session_only_aliases", "sources"],
      "properties": {
        "schema_version": { "const": 1 },
        "inventory_schema_version": { "const": 1 },
        "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "lock_timeout_seconds": { "type": "number", "minimum": 0.1, "maximum": 30 },
        "provider_runtimes": { "type": "object", "additionalProperties": { "enum": ["claude", "codex", "grok", "grokbot-cursor"] } },
        "aliases": { "type": "object" },
        "session_only_aliases": { "type": "object" },
        "sources": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "runtime", "kind", "path", "format", "key"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "runtime": { "enum": ["claude", "codex", "grok", "grokbot-cursor"] },
              "kind": { "enum": ["mcp", "plugin", "app", "connector", "capability"] },
              "path": { "type": "string", "minLength": 1 },
              "format": { "enum": ["json-object-keys", "json-list", "toml-object-keys", "toml-list"] },
              "key": { "type": "string", "minLength": 1 },
              "disabled": { "type": "boolean" },
              "disabled_key": { "type": "string" }
            }
          }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "required": ["schema_version", "dispatcher", "profiles", "entry_surfaces", "rules"],
      "properties": {
        "schema_version": { "const": 2 },
        "dispatcher": {
          "type": "object", "required": ["selection_mode", "default_provider", "fallback_order", "fallback_on_recorded_unavailability", "relay_known_unqualified_intake"],
          "properties": {
            "selection_mode": { "const": "intake-provider-first" },
            "default_provider": { "type": "string" },
            "fallback_order": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
            "fallback_on_recorded_unavailability": { "const": true },
            "relay_known_unqualified_intake": { "const": true }
          }
        },
        "profiles": {
          "type": "object", "minProperties": 1, "required": ["default"],
          "additionalProperties": {
            "type": "object", "required": ["preferred_dispatcher"],
            "properties": { "preferred_dispatcher": { "type": "string" } }
          }
        },
        "entry_surfaces": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "required": ["host", "providers", "can_dispatch"],
            "properties": {
              "host": { "type": "string" },
              "providers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "can_dispatch": { "type": "boolean" }
            }
          }
        },
        "rules": {
          "type": "object",
          "required": ["single_dispatcher_per_run", "honor_user_selected_intake", "fallback_requires_recorded_unavailability", "authorship_does_not_change_handoff_authority"],
          "properties": {
            "single_dispatcher_per_run": { "const": true },
            "honor_user_selected_intake": { "const": true },
            "fallback_requires_recorded_unavailability": { "const": true },
            "authorship_does_not_change_handoff_authority": { "const": true }
          }
        }
      }
    },
    "handoff_policy": {
      "type": "object",
      "required": ["schema_version", "ordinary_artifacts", "restricted_artifacts", "rules", "standing_review_authorization"],
      "properties": {
        "schema_version": { "const": 1 },
        "ordinary_artifacts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true,
          "not": {
            "contains": {
              "enum": ["credentials", "customer-data", "production-data", "production-export", "restricted-data", "restricted-pii", "secrets", "tokens"]
            }
          }
        },
        "restricted_artifacts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "credentials" } },
            { "contains": { "const": "customer-data" } },
            { "contains": { "const": "production-data" } },
            { "contains": { "const": "production-export" } },
            { "contains": { "const": "restricted-data" } },
            { "contains": { "const": "restricted-pii" } },
            { "contains": { "const": "secrets" } },
            { "contains": { "const": "tokens" } }
          ]
        },
        "rules": {
          "type": "object",
          "required": ["configured_provider_handoffs", "authorship_never_requires_permission", "ordinary_requires_user_permission", "restricted_action", "unknown_artifact_action", "no_permission_escalation_loop", "minimum_necessary_only"],
          "properties": {
            "configured_provider_handoffs": { "const": "preauthorized" },
            "authorship_never_requires_permission": { "const": true },
            "ordinary_requires_user_permission": { "const": false },
            "restricted_action": { "const": "park" },
            "unknown_artifact_action": { "const": "park" },
            "no_permission_escalation_loop": { "const": true },
            "minimum_necessary_only": { "const": true }
          }
        },
        "standing_review_authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_scope",
            "artifact_scope",
            "per_review_approval_required",
            "intake_family_may_review",
            "intake_family_review_scope",
            "intake_family_must_not_be_sole_reviewer",
            "separate_physical_invocation_required",
            "effective_date"
          ],
          "properties": {
            "provider_scope": { "const": "all-configured-review-providers" },
            "artifact_scope": { "const": "ordinary_artifacts" },
            "per_review_approval_required": { "const": false },
            "intake_family_may_review": { "const": true },
            "intake_family_review_scope": { "const": "artifact-only" },
            "intake_family_must_not_be_sole_reviewer": { "const": true },
            "separate_physical_invocation_required": { "const": true },
            "effective_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" }
          }
        }
      }
    },
    "usage_windows": {
      "type": "object",
      "required": ["schema_version", "consumed_by", "seats"],
      "properties": {
        "schema_version": { "const": 3 },
        "consumed_by": { "type": "string" },
        "seats": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "required": ["meter", "windows"],
            "properties": {
              "meter": { "type": "string" },
              "soft_cap_pct": { "type": ["number", "null"] },
              "windows": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "required": ["kind"],
                  "properties": { "kind": { "enum": ["weekly", "monthly", "rolling", "none"] } }
                }
              }
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "required": ["schema_version", "retention_days"],
      "properties": {
        "schema_version": { "const": 1 },
        "retention_days": { "type": "integer", "minimum": 0 },
        "reserve_defaults": { "type": "object" },
        "cost_policy": { "type": "object" },
        "sources": { "type": "object" },
        "observability": {
          "type": "object",
          "required": ["enabled", "events_path", "retention_days"],
          "properties": {
            "enabled": { "type": "boolean" },
            "events_path": { "type": "string", "minLength": 1, "pattern": "^[^~]*$" },
            "retention_days": { "type": "integer", "minimum": 0 },
            "emit_on_resolve": { "type": "boolean" },
            "emit_on_run_brief": { "type": "boolean" },
            "require_explicit_actor_id": { "type": "boolean" },
            "privacy": {
              "type": "object",
              "properties": {
                "forbid_task_bodies": { "const": true },
                "forbid_absolute_paths": { "const": true },
                "forbid_credentials": { "const": true },
                "pseudonymous_actors_only": { "const": true }
              }
            }
          }
        }
      }
    },
    "review_depth": {
      "type": "object",
      "required": ["schema_version", "levels_order", "classes"],
      "properties": {
        "schema_version": { "const": 1 },
        "levels_order": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
        "classes": { "type": "object", "minProperties": 1 }
      }
    },
    "roles": {
      "type": "object",
      "required": ["schema_version", "roles"],
      "properties": {
        "schema_version": { "const": 3 },
        "roles": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["description", "level", "seat", "read_only", "deny_tools", "prompt"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "level": { "enum": ["frontier", "sole", "terra", "luna"] },
              "seat": { "type": "string" },
              "read_only": { "type": "boolean" },
              "deny_tools": { "type": "array", "items": { "type": "string" } },
              "prompt": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "required": ["schema_version", "skills"],
      "properties": {
        "schema_version": { "const": 1 },
        "skills": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["description", "kind", "required_capability", "hosts"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["read", "write"] },
              "required_capability": { "type": ["string", "null"] },
              "hosts": { "type": "array", "minItems": 1, "items": { "enum": ["claude", "grok", "codex"] } }
            }
          }
        }
      }
    },
    "model_registry": {
      "type": "object",
      "required": ["schema_version", "as_of", "families", "models", "routes", "roles", "rankings", "intake", "official_sources"],
      "properties": {
        "schema_version": { "const": 1 },
        "as_of": { "type": "string", "minLength": 10 },
        "families": { "type": "object", "minProperties": 1 },
        "models": { "type": "object", "minProperties": 1 },
        "routes": { "type": "object", "minProperties": 1 },
        "roles": { "type": "object", "minProperties": 1 },
        "rankings": { "type": "object", "minProperties": 1 },
        "official_sources": {
          "type": "object",
          "required": ["allowed_domains_by_family", "by_family"],
          "properties": {
            "allowed_domains_by_family": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "by_family": { "type": "object", "minProperties": 1 }
          }
        },
        "intake": {
          "type": "object",
          "required": ["promote_requires", "legacy_waiver_routes"],
          "properties": {
            "promote_requires": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "legacy_waiver_routes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "seat_exec": {
      "type": "object",
      "required": ["schema_version", "recipes"],
      "properties": {
        "schema_version": { "const": 1 },
        "wrappers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["bin", "prefix", "model_flag"],
            "properties": {
              "bin": { "type": "string", "minLength": 1 },
              "prefix": { "type": "array", "items": { "type": "string" } },
              "model_flag": { "type": "string", "minLength": 1 }
            }
          }
        },
        "recipes": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["bin", "args_template", "reads", "worktree", "never_metered_host"],
            "properties": {
              "bin": { "type": ["string", "null"] },
              "args_template": { "type": "array", "items": { "type": "string" } },
              "reads": { "enum": ["brief", "git-diff", "preview-url", "analytics", "marketplace-evidence", "none"] },
              "worktree": { "type": "boolean" },
              "never_metered_host": { "type": "boolean" },
              "separate_invocation_when_dispatcher": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
